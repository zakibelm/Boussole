# Copier en .env (jamais commité) et adapter localement.
# Aucune clé API ici : la clé OpenRouter se saisit dans la page Paramètres
# et reste dans le Gestionnaire d'identifiants Windows.

# Base PostgreSQL locale (voir infra/docker-compose.yml). Sans cette variable,
# Boussole démarre en mode local léger (SQLite, paramètres d'agents seulement).
BOUSSOLE_DATABASE_URL=postgresql+psycopg://boussole@localhost:5432/boussole
# Base de test pour les tests d'intégration
BOUSSOLE_TEST_DATABASE_URL=postgresql+psycopg://boussole@localhost:5432/boussole_test

# Taux de conversion des coûts OpenRouter (USD) en dollars canadiens
BOUSSOLE_USD_CAD_RATE=1.40
# Budget d'essai de la phase en dollars canadiens (arrêt automatique au plafond)
BOUSSOLE_BUDGET_CAP_CAD=20
# Nom de l'humain qui signe les modifications (par défaut : utilisateur Windows)
BOUSSOLE_OPERATOR=
# Rôle de l'opérateur pour valider les décisions (voir approvers dans config/autonomy.yaml)
BOUSSOLE_OPERATOR_ROLE=pmo
# Score minimal d'un extrait (similarité cosinus) : en dessous, la question est hors sujet
# et aucun appel payant n'est fait (mesuré le 2026-11-01 : hors sujet ≤ 0,30, pertinent ≥ 0,45)
BOUSSOLE_MIN_RELEVANCE=0.32
# Origines autorisées à envoyer des formulaires, en plus de l'hôte de la requête (CSRF)
BOUSSOLE_ALLOWED_ORIGINS=https://boussole.optigenius.pro
# 1 : l'opérateur est le compte authentifié par nginx (en-tête X-Remote-User posé par nginx)
BOUSSOLE_TRUST_PROXY_USER=0
# Rôle de chaque compte nginx (avec BOUSSOLE_TRUST_PROXY_USER=1); un compte absent ne valide rien
BOUSSOLE_ROLES=zaki=pmo
