# Variables de production. À copier en /srv/boussole/boussole.env (chmod 600, root).
# Aucune clé ici : la clé OpenRouter se saisit dans la page Paramètres et la clé de
# signature du journal se crée avec audit.cli init-key; les deux vont dans le coffre
# (/srv/boussole/secrets).

# Base : mode léger SQLite dans le volume de données (rien à définir).
# BOUSSOLE_DATABASE_URL=

BOUSSOLE_USD_CAD_RATE=1.40
BOUSSOLE_BUDGET_CAP_CAD=20
BOUSSOLE_TASK_CAP_CAD=0.50
BOUSSOLE_MIN_RELEVANCE=0.32

# Origine publique : obligatoire, sinon les formulaires sont refusés (filtre CSRF)
BOUSSOLE_ALLOWED_ORIGINS=https://boussole.optigenius.pro

# Identité : chaque personne a son compte nginx; le rôle de chaque compte est ici.
# Un compte absent de BOUSSOLE_ROLES ne valide rien et ne modifie pas les paramètres.
BOUSSOLE_TRUST_PROXY_USER=1
BOUSSOLE_ROLES=zaki=pmo
BOUSSOLE_OPERATOR=zaki

# Ancre quotidienne du journal, envoyée hors du serveur par infra/anchor-cron.sh (HTTPS).
# Adresse de l'Application Web Apps Script (infra/anchor-receiver/), SANS paramètre :
# le jeton part dans le corps du POST. Même jeton que JETON dans le script publié.
BOUSSOLE_ANCHOR_URL=
BOUSSOLE_ANCHOR_TOKEN=
